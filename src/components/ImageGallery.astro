---
const slides = [
  { desktop: "/ref/slider-1-desktop.webp", mobile: "/ref/slider-1-mobile.webp", alt: "Capa do material de atividades terapêuticas com Tangram" },
  { desktop: "/ref/slider-2-desktop.webp", mobile: "/ref/slider-2-mobile.webp", alt: "Página com cartas coloridas do material" },
  { desktop: "/ref/slider-3-desktop.webp", mobile: "/ref/slider-3-mobile.webp", alt: "Página de atividade com figuras geométricas coloridas" },
  { desktop: "/ref/slider-4-desktop.webp", mobile: "/ref/slider-4-mobile.webp", alt: "Página de atividade com formas de Tangram" },
  { desktop: "/ref/slider-5-desktop.webp", mobile: "/ref/slider-5-mobile.webp", alt: "Página com modelos coloridos para montar" },
  { desktop: "/ref/slider-6-desktop.webp", mobile: "/ref/slider-6-mobile.webp", alt: "Página com novas propostas de figuras" },
  { desktop: "/ref/slider-7-desktop.webp", mobile: "/ref/slider-7-mobile.webp", alt: "Página de atividade prática do material" },
  { desktop: "/ref/slider-8-desktop.webp", mobile: "/ref/slider-8-mobile.webp", alt: "Página de categorização com cores e formas" },
  { desktop: "/ref/slider-9-desktop.webp", mobile: "/ref/slider-9-mobile.webp", alt: "Página ilustrada para contação de histórias" },
  { desktop: "/ref/slider-10-desktop.webp", mobile: "/ref/slider-10-mobile.webp", alt: "Capa do volume de atividades com Tangram" },
];

const topSlides = slides.slice(0, 5);
const bottomSlides = slides.slice(5);
---

<div class="brand-surface mt-8 overflow-hidden rounded-2xl">
  <div class="bg-teal px-6 py-4 text-center">
    <h2 class="font-display text-lg font-bold tracking-wide text-teal-foreground sm:text-xl">
      VEJA O MATERIAL POR DENTRO
    </h2>
  </div>

  <p class="px-6 pt-5 text-center text-[15px] leading-relaxed text-ink/70 sm:px-8">
    Da abertura ao fechamento — tudo estruturado para você nunca perder o fio da sessão.
  </p>

  <!-- Top row: page mockups - auto-scrolling marquee -->
  <div class="mt-5 mb-6 overflow-hidden">
    <div class="marquee-group" data-gallery="top">
      <div class="marquee-content">
        {[...topSlides, ...topSlides, ...topSlides].map((slide) => (
          <div class="marquee-item">
            <picture>
              <source media="(max-width: 639px)" srcset={slide.mobile} />
              <img src={slide.desktop} alt={slide.alt} loading="eager" class="w-full rounded-xl shadow-[0_10px_30px_-10px_rgba(52,52,52,0.18)]" />
            </picture>
          </div>
        ))}
      </div>
    </div>
  </div>

  <!-- Bottom row: infographics - auto-scrolling marquee (reverse) -->
  <div class="overflow-hidden px-4 pb-6 sm:px-8 sm:pb-8">
    <div class="marquee-group marquee-reverse" data-gallery="bottom">
      <div class="marquee-content">
        {[...bottomSlides, ...bottomSlides, ...bottomSlides].map((slide) => (
          <div class="marquee-item">
            <picture>
              <source media="(max-width: 639px)" srcset={slide.mobile} />
              <img src={slide.desktop} alt={slide.alt} loading="eager" class="w-full rounded-xl shadow-[0_10px_30px_-10px_rgba(52,52,52,0.18)]" />
            </picture>
          </div>
        ))}
      </div>
    </div>
  </div>
</div>

<style>
  .marquee-group {
    display: flex;
    width: fit-content;
  }

  .marquee-content {
    display: flex;
    gap: 1rem;
    animation: marquee 20s linear infinite;
  }

  .marquee-reverse .marquee-content {
    animation-direction: reverse;
  }

  .marquee-group:hover .marquee-content {
    animation-play-state: paused;
  }

  .marquee-item {
    flex-shrink: 0;
    width: 70vw;
  }

  @media (min-width: 640px) {
    .marquee-item {
      width: 45%;
    }
  }

  @media (min-width: 1024px) {
    .marquee-item {
      width: 23%;
    }
  }

  @keyframes marquee {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-33.333%);
    }
  }
</style>
