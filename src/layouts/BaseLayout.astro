---
export interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
}

import "@fontsource/raleway/400.css";
import "@fontsource/raleway/400-italic.css";
import "@fontsource/raleway/500.css";
import "@fontsource/raleway/600.css";
import "@fontsource/raleway/700.css";
import "@fontsource/raleway/800.css";

const {
  title = "Atividades Terapêuticas com Tangram | E-book",
  description = "E-book de atividades com Tangram para terapeutas, professores, pais e cuidadores.",
  ogImage = "/og-image.webp",
} = Astro.props;
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Renata Soárez" />

    <link rel="preload" as="image" href="/media/book-mobile.webp" media="(max-width: 639px)" fetchpriority="high" />
    <link rel="preload" as="image" href="/media/book-desktop.webp" media="(min-width: 640px)" fetchpriority="high" />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:site_name" content="Atividades Terapêuticas com Tangram" />
    <meta property="og:url" content="/" />
    <meta property="og:type" content="website" />

    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="icon" href="/favicon.ico" type="image/x-icon" />
  </head>
  <body>
    <slot />
  </body>
</html>
